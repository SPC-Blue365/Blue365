# 이 파일을 .streamlit/secrets.toml 로 복사한 뒤 값을 채우세요. (secrets.toml 은 git에 올라가지 않습니다)
# 환경변수(QMS_SMTP_PASSWORD, QMS_WEBHOOK_URL, QMS_LIMS_PASSWORD, QMS_LIMS_TOKEN, ANTHROPIC_API_KEY,
# QMS_ACCESS_PASSWORD)가 있으면 그 값이 우선합니다.

[access]
# 사내망 공유 실행 시 접속 비밀번호(비워 두거나 이 섹션을 지우면 비밀번호 없이 열림)
password = ""

[notify]
smtp_password = "메일 계정 비밀번호 또는 앱 비밀번호"
webhook_url = "https://hooks.slack.com/services/XXX/YYY/ZZZ"

[lims]
password = "LIMS 읽기 전용 DB 계정 비밀번호 (연결 주소의 {password} 자리에 들어감)"
token = "LIMS REST API 토큰"

[anthropic]
api_key = "Claude API 키 (AI 솔루션 보고서용, 사내 보안 승인 후 사용)"
